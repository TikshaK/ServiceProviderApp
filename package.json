{
  "name": "ServiceProviderApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "androidBundle": "npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --sourcemap-output android/app/src/main/assets/index.android.bundle.map --assets-dest android/app/src/main/res/",
    "xcode": "cd ios && open ServiceProviderApp.xcworkspace",
    "pods": "cd ios && pod install && cd ..",
    "iosBundle": "npx react-native bundle --entry-file='index.js' --bundle-output='./ios/main.jsbundle' --sourcemap-output='./ios/main.jsbundle.map' --dev=false --platform='ios' --assets-dest='./ios'",
    "clean": "cd android && ./gradlew clean && cd ..",
    "apk": "cd android && ./gradlew assembleRelease && cd ..",
    "apkD": "cd android && ./gradlew assembleDebug && cd ..",
    "aab": "cd android && ./gradlew bundleRelease && cd ..",
    "watch": "watchman watch-del-all",
    "reset": "react-native start --reset-cache"
  },
  "dependencies": {
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/database": "^26.4.0",
    "@react-native/new-app-screen": "0.86.3",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@reduxjs/toolkit": "^2.12.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-date-picker": "^5.0.13",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-permissions": "^5.6.2",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-screens": "^4.28.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-vector-icons": "^10.3.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
